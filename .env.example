# Copy to .env.local for local development. Every value is optional.

# Claude. Leave the key unset and the chat runs a scripted demo that costs
# nothing, so the template deploys with one click.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Map tiles: the address of a MapLibre style, such as OpenFreeMap's
# https://tiles.openfreemap.org/styles/liberty (free, no key), or an XYZ
# template for raster tiles with {z}/{x}/{y}. Defaults to OpenStreetMap,
# whose tile policy doesn't allow heavy use: pick a provider for production.
MAP_TILE_URL=
# The credit in the map's corner, for an XYZ template (a style brings its
# own), as HTML. Only text and https links are kept.
MAP_ATTRIBUTION=

# An OSRM server, such as https://router.project-osrm.org, to draw the route
# along the roads. Without it, stops are joined by straight lines.
ROUTING_URL=

# Upstash Redis, for rate limits shared between instances. Without them, each
# instance keeps its own limits in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
